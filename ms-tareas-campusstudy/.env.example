# Copia este archivo como .env y ajusta los valores

# ===== Base de datos MySQL =====
BASE_DATOS_URL=mysql+pymysql://root:tu_clave@localhost:3306/campusstudy_tareas?charset=utf8mb4

# ===== Modo de operación =====
# false = integración real con los otros microservicios (tercera entrega)
# true  = datos simulados internos, sin red (sirve si un equipo aún no está listo)
SIMULAR_SERVICIOS=false
SIMULAR_NOTIFICACIONES_CAIDAS=false

# ===== URLs de los servicios de los otros equipos =====
# Con los simuladores de mocks/servidores.py son estas mismas.
# El día de la integración se reemplazan por las direcciones reales.
URL_USUARIOS=http://localhost:8008
URL_MATERIAS=http://localhost:8009
URL_GRUPOS=http://localhost:8002
URL_NOTIFICACIONES=http://localhost:8007

# ===== Rutas de cada servicio =====
# Si un equipo publica su endpoint con otra ruta, se cambia aquí.
# El {id} lo reemplaza el servicio automáticamente.
RUTA_USUARIO=/api/v1/usuarios/{id}
RUTA_MATERIA=/api/v1/materias/{id}
RUTA_GRUPO=/api/v1/grupos/{id}
RUTA_NOTIFICACION=/api/v1/notificaciones
RUTA_VALIDAR_TOKEN=/api/v1/auth/validar

# ===== Seguridad =====
# true  = cada servicio valida el token contra Usuarios (#8)
# false = lo valida el API Gateway (#5) y los servicios confían en él
VALIDAR_TOKEN_CON_USUARIOS=false
# Reenviar el token del estudiante a los servicios que consultamos
PROPAGAR_TOKEN_USUARIO=true
# Token propio entre servicios, si los equipos acuerdan usar uno
TOKEN_SERVICIO=
# Origen del Front (#6). Varios se separan con coma. * permite cualquiera.
ORIGENES_PERMITIDOS=*

# ===== Rendimiento de la integración =====
CACHE_SEGUNDOS_REFERENCIAS=60
CACHE_SEGUNDOS_TOKEN=120
HORAS_IDEMPOTENCIA=24

# ===== Manejo de fallos (sección J del contrato) =====
TIMEOUT_SEGUNDOS=3
ESPERAS_REINTENTO=1,2
FALLOS_PARA_ABRIR_CIRCUITO=5
SEGUNDOS_CIRCUITO_ABIERTO=30
MINUTOS_REINTENTO_EVENTOS=5
HORAS_MAXIMO_EVENTO=24

# ===== Compatibilidad con Notificaciones (#7) =====
# Si ese equipo usa otros nombres de campo, se renombran aquí sin tocar el código.
# Ejemplo: {"usuario_id": "destinatario", "tipo": "evento"}
NOTIFICACION_MAPA_CAMPOS={}
